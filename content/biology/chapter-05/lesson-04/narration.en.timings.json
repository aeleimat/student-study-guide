  "cues": [
   [
    0.104,
    "Lesson three gave us the parts of a nucleotide: a phosphate on the five prime carbon, a sugar, and a base on the one prime carbon."
   ],
   [
    8.346,
    "Here are three nucleotides, loose."
   ],
   [
    10.807,
    "Look at the sugar of the first."
   ],
   [
    12.669,
    "On its three prime carbon sits a hydroxyl group, an O H."
   ],
   [
    17.07,
    "The phosphate on the five prime carbon of the next nucleotide meets it, and the two join by a covalent bond called a phosphodiester bond."
   ],
   [
    25.365,
    "Water leaves, so this is dehydration, as in lesson one."
   ],
   [
    29.57,
    "The third nucleotide joins the same way: its five prime phosphate to the free three prime hydroxyl of the one before."
   ],
   [
    37.37,
    "Now the chain has two different ends."
   ],
   [
    39.544,
    "One end shows a free phosphate on a five prime carbon: the five prime end."
   ],
   [
    44.596,
    "The other shows a free hydroxyl on a three prime carbon: the three prime end."
   ],
   [
    49.818,
    "So a strand has a direction, and we read it from five prime to three prime."
   ]
  ]
 },
