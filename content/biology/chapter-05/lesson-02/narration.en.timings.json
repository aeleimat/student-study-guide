  "cues": [
   [
    0.117,
    "There are two kinds of nucleic acid."
   ],
   [
    2.422,
    "Deoxyribonucleic acid, or DNA."
   ],
   [
    5.443,
    "And ribonucleic acid, or RNA."
   ],
   [
    8.112,
    "DNA gives directions for its own replication."
   ],
   [
    11.224,
    "Before a cell divides, it copies its DNA, so each new cell gets a full set of recipes."
   ],
   [
    17.604,
    "DNA also directs the making of messenger RNA, called mRNA, and through mRNA, it controls protein synthesis."
   ],
   [
    26.003,
    "The messenger is a working copy."
   ],
   [
    28.125,
    "The master recipe stays safe in the nucleus."
   ]
