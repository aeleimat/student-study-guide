  "cues": [
   [
    0.117,
    "Cellular respiration has three stages."
   ],
   [
    3.021,
    "Glycolysis breaks glucose into two pyruvate."
   ],
   [
    6.667,
    "The citric acid cycle completes the breakdown of glucose."
   ],
   [
    10.495,
    "And oxidative phosphorylation accounts for most of the ATP."
   ],
   [
    14.388,
    "Now look at the map."
   ],
   [
    15.612,
    "It shows a fourth box, between glycolysis and the cycle, called pyruvate oxidation."
   ],
   [
    22.005,
    "It is a bridge, a short link step, so the slides count three stages, and the map shows the bridge between them."
   ],
   [
    29.01,
    "Both are correct."
   ]
  ]
