   [
    0.104,
    "Chapter nine, lesson three."
   ],
   [
    2.201,
    "The stages of cellular respiration."
   ],
   [
    4.622,
    "Think of a water mill on a stream."
   ],
   [
    6.667,
    "The water does not turn the wheel in one jump."
   ],
   [
    9.414,
    "It passes through a series of stages, and the work is done along the way."
   ],
   [
    13.867,
    "Cellular respiration is like that."
   ],
   [
    16.289,
    "Here is the map from lesson one, with its parts still dim."
   ],
   [
    19.792,
    "Today we light it up, stage by stage, and then follow one glucose all the way through."
   ]
  ]
