  "cues": [
   [
    0.104,
    "A T P synthase has four parts."
   ],
   [
    2.474,
    "The stator is anchored in the membrane, and it stays still."
   ],
   [
    6.016,
    "The rotor is a ring of subunits in the membrane, and it can spin."
   ],
   [
    10.365,
    "The internal rod is a stalk that turns with the rotor."
   ],
   [
    13.438,
    "And the catalytic knob sits at the top of the rod, on the matrix side."
   ],
   [
    17.865,
    "Step one."
   ],
   [
    18.828,
    "Protons flow down their gradient into a channel in the stator."
   ],
   [
    22.904,
    "Step two."
   ],
   [
    23.867,
    "They bind to sites in the rotor, and change the shape of each subunit, so the rotor spins."
   ],
   [
    29.622,
    "Step three."
   ],
   [
    30.703,
    "Each proton makes one full turn, and leaves through a second channel into the matrix."
   ],
   [
    36.458,
    "Step four."
   ],
   [
    37.526,
    "The spinning rotor turns the rod, while the stator holds the knob still."
   ],
   [
    42.161,
    "And step five."
   ],
   [
    43.425,
    "The turning rod activates the catalytic sites in the knob, which make A T P from A D P and phosphate."
   ],
   [
    50.859,
    "It really is a tiny turbine."
   ],
   [
    52.878,
    "Moving protons turn it, and the turning makes A T P."
   ]
  ]
 },
