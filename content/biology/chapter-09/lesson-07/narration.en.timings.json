  "cues": [
   [
    0.117,
    "Why twenty six or twenty eight, and why only about?"
   ],
   [
    3.346,
    "The N A D H made in glycolysis sits in the cytosol, and it cannot cross into the mitochondrion."
   ],
   [
    10.156,
    "Electron shuttles span the membrane and carry its electrons in."
   ],
   [
    14.648,
    "Depending on the shuttle, they arrive as two N A D H, or as two F A D H 2."
   ],
   [
    21.901,
    "F A D H 2 enters lower in the chain, so it pumps fewer protons, and gives less A T P."
   ],
   [
    28.997,
    "There is more."
   ],
   [
    30.039,
    "The proton gradient is also used for other work, so not every proton goes to A T P synthase."
   ],
   [
    36.458,
    "And the number of protons per A T P is not a whole number."
   ],
   [
    40.417,
    "So thirty or thirty two is an estimate, a maximum, not an exact count."
   ],
   [
    45.703,
    "Say about, never exactly."
   ]
  ]
 },
