  "cues": [
   [
    0.104,
    "This use of the energy stored in an H plus gradient to do cellular work is called chemiosmosis."
   ],
   [
    6.562,
    "Because the gradient can do work, it is called a proton motive force."
   ],
   [
    10.82,
    "It is the link between two worlds."
   ],
   [
    13.086,
    "On one side, the redox reactions of the chain."
   ],
   [
    16.289,
    "On the other, the making of A T P."
   ],
   [
    19.128,
    "The gradient couples them."
   ],
   [
    20.599,
    "Put the two halves together and you have oxidative phosphorylation."
   ],
   [
    24.622,
    "Part one, the electron transport chain, makes the gradient."
   ],
   [
    28.763,
    "Part two, chemiosmosis, uses the gradient to make A T P."
   ],
   [
    33.711,
    "Neither half makes A T P alone."
   ],
   [
    36.432,
    "So the energy flows like this."
   ],
   [
    38.464,
    "Glucose gives its electrons to N A D H."
   ],
   [
    42.318,
    "The slide leaves out F A D H 2, but it joins in at complex two."
   ],
   [
    47.656,
    "N A D H feeds the electron transport chain."
   ],
   [
    51.185,
    "The chain builds the proton motive force."
   ],
   [
    53.763,
    "And the proton motive force makes A T P."
   ]
  ]
 },
