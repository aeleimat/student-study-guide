  "cues": [
   [
    0.104,
    "NAD\u207a is a coenzyme, a helper molecule that carries electrons."
   ],
   [
    5.495,
    "Its working part is a ring, called nicotinamide."
   ],
   [
    8.776,
    "In the oxidized form, the ring carries a positive charge."
   ],
   [
    12.552,
    "Add two electrons and one proton, and the charge is cancelled, and an extra hydrogen sits on the ring."
   ],
   [
    19.18,
    "Now it is NADH, the reduced form."
   ],
   [
    22.812,
    "The slide writes this as NAD\u207a plus two H in brackets, gives NADH plus a proton."
   ],
   [
    31.367,
    "The two H in brackets just means two hydrogen atoms, two protons and two electrons."
   ],
   [
    37.5,
    "And the change runs both ways."
   ],
   [
    39.531,
    "Give the electrons away, and NADH is oxidized back to NAD\u207a."
   ]
  ]
 },
