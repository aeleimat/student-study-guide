  "cues": [
   [
    0.117,
    "Start with alcohol fermentation."
   ],
   [
    2.422,
    "Glycolysis makes two pyruvate and two A T P, and two N A D plus have become two N A D H."
   ],
   [
    10.664,
    "Now each pyruvate loses a carbon as carbon dioxide, and becomes acetaldehyde, a molecule with two carbons."
   ],
   [
    18.542,
    "Then N A D H hands its electrons to the acetaldehyde, which is reduced to ethanol."
   ],
   [
    24.583,
    "And that hands the cell its N A D plus back, ready for more glycolysis."
   ],
   [
    29.701,
    "So per glucose: two pyruvate, two carbon dioxide, and two ethanol."
   ]
  ]
 },
