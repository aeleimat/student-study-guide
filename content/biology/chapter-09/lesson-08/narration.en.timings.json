  "cues": [
   [
    0.104,
    "In anaerobic respiration, the cell still runs an electron transport chain."
   ],
   [
    5.143,
    "But the last electron acceptor is not oxygen."
   ],
   [
    8.216,
    "In some bacteria it is sulfate."
   ],
   [
    10.508,
    "The chain still pumps protons, and chemiosmosis still makes A T P, so this is respiration, just with a different acceptor at the end."
   ],
   [
    19.766,
    "Fermentation has no chain at all."
   ],
   [
    22.005,
    "The only A T P comes from glycolysis, by substrate-level phosphorylation, where an enzyme hands a phosphate straight to A D P."
   ],
   [
    30.716,
    "Fermentation is simply glycolysis, plus reactions that regenerate N A D plus, so that glycolysis can keep going."
   ],
   [
    38.841,
    "There are two common kinds: alcohol fermentation, and lactic acid fermentation."
   ]
  ]
 },
