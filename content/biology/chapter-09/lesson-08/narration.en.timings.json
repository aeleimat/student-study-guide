  "cues": [
   [
    0.104,
    "Now we can read the fork."
   ],
   [
    1.719,
    "Glucose goes through glycolysis and becomes pyruvate in the cytosol."
   ],
   [
    6.458,
    "With no oxygen, pyruvate goes to fermentation: ethanol, lactate, or other products."
   ],
   [
    13.216,
    "With oxygen present, pyruvate enters the mitochondrion as acetyl co-A, and the citric acid cycle follows."
   ],
   [
    21.055,
    "Some organisms stay on one branch."
   ],
   [
    23.698,
    "Obligate anaerobes use only fermentation or anaerobic respiration, and they cannot survive in oxygen."
   ],
   [
    30.729,
    "Facultative anaerobes can use either branch."
   ],
   [
    33.932,
    "Yeast, and many bacteria, ferment when oxygen is missing and respire when it is there."
   ],
   [
    39.883,
    "They choose by what the environment offers."
   ]
  ]
 },
