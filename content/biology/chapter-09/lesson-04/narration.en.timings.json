    0.104,
    "Step four is the split that gives glycolysis its name."
   ],
   [
    3.75,
    "The enzyme aldolase cuts the six-carbon sugar into two different three-carbon sugars."
   ],
   [
    9.518,
    "One is glyceraldehyde three-phosphate, or G3P."
   ],
   [
    13.568,
    "The other is dihydroxyacetone phosphate, or DHAP."
   ],
   [
    18.607,
    "Count the carbons: six becomes three plus three."
   ],
   [
    22.135,
    "Nothing is lost."
   ],
   [
    23.438,
    "Step five, an isomerase, turns DHAP into G3P, and it keeps going, because G3P is used as fast as it forms."
   ],
   [
    34.505,
    "So from here on, there are two G3P, and every payoff step happens twice."
   ],
   [
    40.26,
    "That is why the slide writes a two in front of each molecule."
   ]
  ]
