  "cues": [
   [
    0.104,
    "Glycolysis means splitting of sugar."
   ],
   [
    2.617,
    "It takes one glucose, six carbons, and breaks it into two pyruvate, three carbons each."
   ],
   [
    9.154,
    "It all happens in the cytosol, and it needs no oxygen."
   ],
   [
    12.747,
    "Its ten steps fall into two phases."
   ],
   [
    15.599,
    "First, the energy investment phase, steps one to five, where the cell spends two ATP."
   ],
   [
    22.201,
    "Then the energy payoff phase, steps six to ten, where it earns that back, and more."
   ],
   [
    28.021,
    "Here are the ten steps as a strip."
   ],
   [
    30.013,
    "You don't need to memorize the names."
   ],
   [
    32.175,
    "Just know what each phase does."
   ]
  ]
 },
