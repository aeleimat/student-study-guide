  "cues": [
   [
    0.104,
    "Not every redox reaction hands electrons over completely."
   ],
   [
    4.18,
    "Some only shift how electrons are shared in covalent bonds."
   ],
   [
    8.021,
    "Burning methane is one: methane plus two oxygen makes carbon dioxide and two water, plus energy."
   ],
   [
    15.482,
    "In methane, carbon shares its electron pairs fairly evenly with hydrogen."
   ],
   [
    20.534,
    "In carbon dioxide, the shared pairs sit closer to oxygen, because oxygen is very electronegative."
   ],
   [
    27.487,
    "So carbon has lost its share of electrons: it is oxidized."
   ],
   [
    31.562,
    "And oxygen has gained a share: it is reduced."
   ],
   [
    34.805,
    "Methane is the reducing agent, and oxygen is the oxidizing agent."
   ],
   [
    39.648,
    "Glucose burns the same way."
   ],
   [
    41.654,
    "Its carbons are oxidized to carbon dioxide, oxygen is reduced to water, and that shift in electron sharing is the energy we are after."
   ]
  ]
 },
