    0.104,
    "How does breaking down glucose release energy?"
   ],
   [
    3.034,
    "Through redox reactions, short for oxidation and reduction."
   ],
   [
    7.266,
    "These are reactions that move electrons from one substance to another."
   ],
   [
    11.536,
    "Take a sodium atom and a chlorine atom."
   ],
   [
    14.128,
    "Sodium hands one electron to chlorine."
   ],
   [
    16.68,
    "Losing electrons is oxidation, so sodium is oxidized, and becomes a sodium ion."
   ],
   [
    22.826,
    "Gaining electrons is reduction, so chlorine is reduced, and becomes a chloride ion."
   ],
   [
    28.867,
    "Its charge drops, from zero to negative."
   ],
   [
    31.979,
    "The electron donor is called the reducing agent, because its electrons reduce the other substance."
   ],
   [
    38.099,
    "The electron receptor is called the oxidizing agent."
   ],
   [
    41.576,
    "Here sodium is the reducing agent, and chlorine the oxidizing agent."
   ],
   [
    46.237,
    "Notice that the two always happen together."
   ],
   [
    48.945,
    "One substance's loss is the other's gain."
   ]
  ]
