   [
    0.104,
    "Chapter nine, lesson nine."
   ],
   [
    2.096,
    "Connections to other pathways, and regulation."
   ],
   [
    5.169,
    "Picture a railway junction."
   ],
   [
    7.188,
    "Trains from many lines arrive, share a few tracks, and leave again on others."
   ],
   [
    12.357,
    "Our respiration map works the same way."
   ],
   [
    15.143,
    "For eight lessons we followed one fuel, glucose, through it."
   ],
   [
    19.349,
    "But a cell does not live on glucose alone."
   ],
   [
    22.096,
    "Today we light up the doors where other fuels come in, and then the dial that controls the whole map."
   ]
  ]
