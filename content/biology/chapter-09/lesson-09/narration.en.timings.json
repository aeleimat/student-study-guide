  "cues": [
   [
    0.104,
    "Carbohydrates are the easy case."
   ],
   [
    2.422,
    "Starch and other sugars are broken down to simple sugars, and glycolysis accepts a wide range of them."
   ],
   [
    9.062,
    "Proteins must first be digested to amino acids."
   ],
   [
    12.565,
    "Then the amino group is taken off, and it leaves as N H three."
   ],
   [
    17.292,
    "What remains is the carbon skeleton, and that is what feeds in."
   ],
   [
    21.198,
    "Some skeletons join at pyruvate, some become acetyl co-A, and some enter the citric acid cycle directly."
   ],
   [
    28.646,
    "The slide says the amino groups feed in, but it is the carbon skeletons that burn."
   ],
   [
    33.854,
    "The nitrogen leaves."
   ]
  ]
