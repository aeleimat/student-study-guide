  "cues": [
   [
    0.13,
    "Here is figure seven seven, a tour of all the parts."
   ],
   [
    3.724,
    "The outer face looks out at the extracellular fluid, with the fibres of the ECM, the extracellular matrix."
   ],
   [
    11.094,
    "The inner face looks into the cytoplasm, where the microfilaments of the cytoskeleton run."
   ],
   [
    16.719,
    "In between, the bilayer, with cholesterol tucked between the tails, as in lesson one."
   ],
   [
    22.63,
    "Embedded in it, like tiles in a mosaic, are the proteins."
   ],
   [
    26.849,
    "A membrane is a collage of different proteins in the fluid lipid bilayer."
   ],
   [
    31.745,
    "This one reaches into the middle of the bilayer: an integral protein."
   ],
   [
    36.12,
    "These are only stuck to the surface, here on the cytoplasmic side: peripheral proteins."
   ],
   [
    41.81,
    "And on the outer face, short chains of sugar."
   ],
   [
    44.779,
    "A chain on a protein makes a glycoprotein."
   ],
   [
    47.747,
    "A chain on a lipid makes a glycolipid."
   ]
  ]
 },
