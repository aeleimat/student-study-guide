  "cues": [
   [
    0.104,
    "Chapter seven, lesson two."
   ],
   [
    2.122,
    "Membrane proteins and carbohydrates."
   ],
   [
    5.026,
    "Think of a border crossing."
   ],
   [
    6.615,
    "A fence runs along the line, but the fence alone does very little."
   ],
   [
    11.081,
    "The work is done by the gates, the guard booths, the scanners, and the badges people carry."
   ],
   [
    16.81,
    "A cell's border works the same way."
   ],
   [
    19.062,
    "Here is the patch of membrane we built in lesson one: a fluid sheet of phospholipids."
   ],
   [
    24.961,
    "Now we light up the rest of it."
   ],
   [
    26.745,
    "The proteins, and the sugar chains."
   ],
   [
    29.206,
    "Proteins determine most of the membrane's specific functions."
   ]
  ]
 },
