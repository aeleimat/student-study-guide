  "cues": [
   [
    0.104,
    "Let's sort the proteins by where they sit."
   ],
   [
    2.487,
    "Peripheral proteins are bound to the surface of the membrane."
   ],
   [
    6.159,
    "They never enter the core of the bilayer."
   ],
   [
    8.581,
    "Integral proteins penetrate the hydrophobic core, the water-avoiding middle where the gold tails are."
   ],
   [
    15.026,
    "Many of them go all the way through, from one side to the other."
   ],
   [
    19.336,
    "An integral protein that spans the membrane is called a transmembrane protein."
   ],
   [
    24.44,
    "Now look at the part inside the core."
   ],
   [
    26.576,
    "It is one or more stretches of nonpolar amino acids, often coiled into a spiral called an alpha helix."
   ],
   [
    34.036,
    "Why nonpolar?"
   ],
   [
    35.234,
    "Because the core is made of fatty acid tails, which avoid water."
   ],
   [
    39.44,
    "Nonpolar amino acids are comfortable there, so the protein stays put in the membrane."
   ]
  ]
