  "cues": [
   [
    0.091,
    "Membrane proteins do six major jobs."
   ],
   [
    3.242,
    "Transport."
   ],
   [
    4.245,
    "Enzymatic activity."
   ],
   [
    5.807,
    "Signal transduction."
   ],
   [
    7.448,
    "Cell to cell recognition."
   ],
   [
    9.245,
    "Intercellular joining."
   ],
   [
    10.729,
    "And attachment to the cytoskeleton and the extracellular matrix."
   ],
   [
    14.922,
    "First, transport."
   ],
   [
    16.549,
    "A passage through the membrane lets a substance cross, and it needs no ATP."
   ],
   [
    21.914,
    "A different protein uses ATP to push a substance across."
   ],
   [
    26.523,
    "Lesson five names them."
   ],
   [
    28.125,
    "Second, enzymatic activity."
   ],
   [
    30.391,
    "An enzyme in the membrane speeds up a reaction, right on the membrane surface."
   ],
   [
    35.99,
    "Third, signal transduction."
   ],
   [
    38.216,
    "A signaling molecule, outside the cell, binds to a receptor."
   ],
   [
    42.669,
    "The receptor passes the message to the inside, and the cell responds."
   ],
   [
    47.227,
    "The signaling molecule itself never has to enter."
   ],
   [
    50.482,
    "Fourth, cell to cell recognition."
   ],
   [
    52.852,
    "A glycoprotein's sugar chain acts like an identity badge, which a neighbouring cell can read."
   ],
   [
    58.633,
    "Fifth, intercellular joining."
   ],
   [
    60.664,
    "Proteins of two neighbouring cells hook together, and hold the cells side by side, like the junctions you saw in chapter six."
   ],
   [
    68.594,
    "And sixth, attachment."
   ],
   [
    70.339,
    "A protein ties the cytoskeleton on the inside to the fibres of the ECM on the outside."
   ]
  ]
 },
