  "cues": [
   [
    0.104,
    "Last time, only small nonpolar molecules slipped through the bilayer easily."
   ],
   [
    5.26,
    "Ions, water, and sugars need help."
   ],
   [
    8.112,
    "That help is called facilitated diffusion."
   ],
   [
    10.651,
    "Transport proteins speed up the passive movement of molecules across the membrane."
   ],
   [
    15.872,
    "Passive, so it takes no energy, and it still runs down the concentration gradient, from crowded to sparse."
   ],
   [
    22.956,
    "A channel protein is a corridor."
   ],
   [
    25.195,
    "It lets one specific molecule or ion cross."
   ],
   [
    28.711,
    "Aquaporins are channels for water."
   ],
   [
    30.977,
    "Gated ion channels open or close in response to a stimulus, such as a chemical signal or a change in voltage."
   ],
   [
    38.438,
    "So the cell decides when the ions flow."
   ],
   [
    40.938,
    "A carrier protein works differently."
   ],
   [
    43.242,
    "It binds the solute, then undergoes a subtle change in shape that moves the binding site across the membrane."
   ],
   [
    50.208,
    "Open to the outside, bind, change shape, open to the inside, release."
   ],
   [
    56.224,
    "Just like a revolving door."
   ],
   [
    57.865,
    "Either way, the solute travels down its gradient, so no energy is needed."
   ]
  ]
 },
