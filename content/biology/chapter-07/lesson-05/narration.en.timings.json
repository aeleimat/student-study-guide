    0.117,
    "But sometimes a cell needs the opposite."
   ],
   [
    2.539,
    "It needs sodium out, even though sodium is already crowded outside."
   ],
   [
    7.135,
    "Active transport moves a solute against its concentration gradient, from sparse to crowded."
   ],
   [
    13.242,
    "That takes energy, usually from ATP."
   ],
   [
    16.68,
    "Think of rolling a ball uphill."
