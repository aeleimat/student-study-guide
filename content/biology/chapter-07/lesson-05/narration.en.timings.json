  "cues": [
   [
    0.117,
    "The best known example is the sodium-potassium pump."
   ],
   [
    3.333,
    "Outside the cell, sodium is high and potassium is low."
   ],
   [
    7.122,
    "Inside, it is the reverse."
   ],
   [
    9.31,
    "Step one."
   ],
   [
    10.273,
    "The pump is open to the cytoplasm, and three sodium ions bind."
   ],
   [
    14.74,
    "Step two."
   ],
   [
    15.703,
    "ATP gives a phosphate to the pump, and becomes ADP."
   ],
   [
    20.182,
    "The pump changes shape."
   ],
   [
    21.68,
    "Step three."
   ],
   [
    22.76,
    "Now it opens to the outside, and releases the three sodium ions into the extracellular fluid."
   ],
   [
    29.219,
    "Step four."
   ],
   [
    30.286,
    "Two potassium ions bind from the outside, and the phosphate comes off."
   ],
   [
    34.974,
    "Step five."
   ],
   [
    36.055,
    "Without the phosphate, the pump returns to its first shape, open to the cytoplasm, holding the potassium."
   ],
   [
    42.8,
    "Step six."
   ],
   [
    43.945,
    "It releases the two potassium ions into the cytoplasm, and the cycle starts again."
   ],
   [
    49.297,
    "Each turn costs one ATP, sends three sodium ions out, and brings two potassium ions in."
   ]
  ]
 },
