    0.104,
    "Chapter seven, lesson six."
   ],
   [
    2.383,
    "Membrane potential, ion pumps, and cotransport."
   ],
   [
    6.042,
    "A sugar beet packs an enormous amount of sugar into its root."
   ],
   [
    10.026,
    "A nerve cell sends signals along its whole length."
   ],
   [
    13.229,
    "Both depend on something invisible at the edge of their cells: an electric voltage."
