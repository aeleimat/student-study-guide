  "cues": [
   [
    0.104,
    "Every living cell is a tiny battery."
   ],
   [
    2.708,
    "There are ions on both sides of the membrane, some positive, some negative."
   ],
   [
    7.279,
    "But they are not spread out evenly."
   ],
   [
    9.154,
    "Just inside the membrane there is a surplus of negative charge, and just outside, a surplus of positive charge."
   ],
   [
    16.419,
    "That difference in charge is a voltage, and the voltage across a membrane is called the membrane potential."
   ],
   [
    22.487,
    "It is measured in millivolts, thousandths of a volt."
   ],
   [
    25.742,
    "The textbook gives animal cells values from about minus fifty to minus two hundred millivolts, and the minus sign says the inside is negative."
   ],
   [
    35.065,
    "The extra charge sits in a thin layer along the two faces of the membrane."
   ],
   [
    39.935,
    "The fluid farther away stays neutral."
   ]
  ]
 },
