   [
    0.117,
    "To sum up."
   ],
   [
    1.016,
    "Membrane potential is the voltage across a membrane, made by uneven ions, with the inside negative."
   ],
   [
    7.786,
    "An ion feels a chemical force and an electrical force, and together they are its electrochemical gradient."
   ],
   [
    14.935,
    "Electrogenic pumps make the voltage: the sodium-potassium pump in animals, the proton pump in plants, fungi, and bacteria."
   ],
   [
    23.867,
    "They store energy as a gradient."
   ],
   [
    26.107,
    "Cotransport lets that stored energy carry another solute, like sucrose, into the cell."
   ],
   [
    32.331,
    "Now try the practice."
   ]
  ]
