  "cues": [
   [
    0.104,
    "Which brings us to cotransport."
   ],
   [
    2.07,
    "Cotransport happens when active transport of one solute indirectly drives the transport of another solute."
   ],
   [
    8.867,
    "Plants commonly use the hydrogen ion gradient made by proton pumps to bring nutrients into the cell."
   ],
   [
    15.326,
    "Take sucrose, the sugar our beet stores."
   ],
   [
    18.372,
    "In the membrane sits a sucrose, hydrogen ion cotransporter."
   ],
   [
    22.904,
    "The protons crowded outside drift back in through it, down their electrochemical gradient."
   ],
   [
    28.685,
    "That is the dotted arrow on the slide, diffusion of hydrogen ions."
   ],
   [
    33.32,
    "But the cotransporter will not let a proton through alone."
   ],
   [
    36.849,
    "A sucrose molecule rides in with each proton, even when there is already more sucrose inside."
   ],
   [
    43.294,
    "So sucrose is carried uphill, and the cell never spends ATP on sucrose itself."
   ],
   [
    49.557,
    "The pump spent it on protons, and that is why we call this transport indirect."
   ]
  ]
 },
