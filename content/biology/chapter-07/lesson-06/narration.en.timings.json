    0.104,
    "Let's follow the whole chain once."
   ],
   [
    2.148,
    "ATP powers the proton pump."
   ],
   [
    4.609,
    "The pump moves protons out, and builds a gradient and a voltage."
   ],
   [
    8.945,
    "Protons flow back in through the cotransporter, carrying sucrose with them."
   ],
   [
    13.555,
    "Sucrose piles up in the cell, which is how a sugar beet fills its root."
   ],
   [
    18.385,
    "Now suppose a poison blocks the pump."
   ],
   [
    20.846,
    "The protons stop piling up, the voltage fades, and the cotransporter has no push left."
   ],
   [
    26.836,
    "Sucrose uptake slows, even though the cotransporter itself is fine."
   ]
  ]
