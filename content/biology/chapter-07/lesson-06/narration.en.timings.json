   [
    0.117,
    "Here is the proton pump at work."
   ],
   [
    2.122,
    "It is powered by ATP."
   ],
   [
    4.18,
    "It takes a hydrogen ion, which is just a proton, from the cytoplasm, and pushes it out into the extracellular fluid, against the gradient."
   ],
   [
    13.438,
    "Every proton that leaves takes one positive charge with it."
   ],
   [
    17.279,
    "Positive charge builds up outside, and negative charge is left behind inside."
   ],
   [
    22.292,
    "The membrane potential grows."
   ],
   [
    24.297,
    "And that is stored energy."
   ],
   [
    25.82,
    "Protons crowded outside, pulled back by the negative inside, are like water behind a dam."
   ],
   [
    31.953,
    "The pump spends ATP to fill the dam, and the cell can spend the stored energy later, on cellular work."
   ]
  ]
