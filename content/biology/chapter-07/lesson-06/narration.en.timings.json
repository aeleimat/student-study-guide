  "cues": [
   [
    0.104,
    "Now, what does that mean for an ion that wants to cross?"
   ],
   [
    3.451,
    "It feels two pushes."
   ],
   [
    5.026,
    "The first is the chemical force, which is just the ion's concentration gradient, from crowded to sparse."
   ],
   [
    11.823,
    "The second is the electrical force, the effect of the membrane potential."
   ],
   [
    16.289,
    "Positive ions are pulled toward the negative inside, and negative ions are pushed away from it."
   ],
   [
    21.94,
    "Together, the two forces are called the electrochemical gradient, and it drives the diffusion of ions across a membrane."
   ],
   [
    29.401,
    "Take a sodium ion."
   ],
   [
    30.964,
    "There is more sodium outside than inside, so the chemical force points in."
   ],
   [
    35.781,
    "The inside is negative, so the electrical force points in as well."
   ],
   [
    39.857,
    "Both agree, and the pull is strong."
   ],
   [
    42.24,
    "A potassium ion is different."
   ],
   [
    44.505,
    "There is more potassium inside, so the chemical force points out, but the negative inside pulls it back in."
   ],
   [
    51.458,
    "When the forces disagree, the ion follows whichever force is stronger."
   ]
  ]
 },
