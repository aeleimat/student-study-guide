  "cues": [
   [
    0.104,
    "Water crosses the membrane by osmosis, from the lesson before."
   ],
   [
    4.557,
    "Now we ask how a cell fares in different solutions."
   ],
   [
    7.76,
    "The word for this is tonicity."
   ],
   [
    9.831,
    "Tonicity is a solution's ability to make a cell gain or lose water."
   ],
   [
    14.766,
    "Always compare the solution with the inside of the cell."
   ],
   [
    18.164,
    "If the solution has the same solute concentration as the cell, it is isotonic."
   ],
   [
    23.568,
    "Water goes in and out at the same rate, so there is no net movement."
   ],
   [
    27.917,
    "If the solution has more solute than the cell, it is hypertonic."
   ],
   [
    32.07,
    "Water leaves the cell, because it moves toward the side with more solute."
   ],
   [
    36.55,
    "If the solution has less solute than the cell, it is hypotonic."
   ],
   [
    40.755,
    "Water enters the cell."
   ],
   [
    42.383,
    "A way to remember it: hyper means more solute outside, and the cell loses water."
   ],
   [
    48.073,
    "Hypo means less solute outside, and the cell gains water."
   ]
  ]
 },
