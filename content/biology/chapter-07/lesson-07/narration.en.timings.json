   [
    0.156,
    "First, out."
   ],
   [
    1.146,
    "In exocytosis, a transport vesicle, loaded with product, migrates to the plasma membrane."
   ],
   [
    7.865,
    "Its membrane fuses with the plasma membrane."
   ],
   [
    10.794,
    "And the contents spill out of the cell."
   ],
   [
    13.047,
    "The vesicle's membrane becomes part of the plasma membrane, so the cell surface grows a little."
   ],
   [
    18.659,
    "Many secretory cells export their products this way."
   ],
   [
    22.005,
    "A cell in the pancreas that releases the hormone insulin is one example, and a gland cell that releases digestive enzymes is another."
   ]
  ]
