  "cues": [
   [
    0.117,
    "The third kind is selective."
   ],
   [
    2.057,
    "Receptor-mediated endocytosis starts with receptors, proteins in the membrane that fit one particular molecule."
   ],
   [
    9.922,
    "Any molecule that binds specifically to the receptor site of another molecule is called a ligand."
   ],
   [
    16.016,
    "When ligands bind their receptors, the membrane region sinks in and a coat of protein lines it."
   ],
   [
    22.5,
    "This is a coated pit."
   ],
   [
    23.945,
    "It pinches off as a coated vesicle, carrying the ligands inside."
   ],
   [
    28.411,
    "Some fluid comes along as well, so even this route is not perfectly selective, but the receptors let the cell pick up its chosen molecules in large amounts."
   ]
  ]
