  "cues": [
   [
    0.104,
    "Let's finish with every way across the membrane in this chapter."
   ],
   [
    3.958,
    "Small nonpolar molecules, like oxygen, slip through the bilayer by simple diffusion, down their gradient."
   ],
   [
    11.38,
    "Water follows its own gradient by osmosis."
   ],
   [
    14.505,
    "Ions and polar molecules go through channels and carriers, which is facilitated diffusion."
   ],
   [
    20.339,
    "Still passive."
   ],
   [
    21.51,
    "To move against a gradient, a pump spends ATP, like the sodium-potassium pump."
   ],
   [
    27.227,
    "Cotransport lets the downhill flow of one solute drag another one uphill, like sucrose with hydrogen ions."
   ],
   [
    34.948,
    "And for big cargo, exocytosis sends vesicles out, and endocytosis brings them in."
   ],
   [
    41.263,
    "Now try the practice."
   ]
  ]
