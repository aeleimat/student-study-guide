    0.091,
    "Concept seven point three."
   ],
   [
    2.005,
    "Passive transport is diffusion across a membrane, with no energy investment from the cell."
   ],
   [
    7.995,
    "Diffusion is the tendency of molecules to spread out evenly into the available space."
   ],
   [
    13.672,
    "Here is a box split by a membrane."
   ],
   [
    16.068,
    "Dye on the left, none on the right."
   ],
   [
    18.281,
    "Every single molecule moves at random."
   ],
   [
    20.951,
    "None of them knows where it is going."
   ],
   [
    22.826,
    "But there are more dye molecules on the left, so more cross from left to right than from right to left."
   ],
   [
    28.424,
    "The population shows net movement to the right, from many random steps."
   ],
   [
    33.125,
    "In the end the dye is spread evenly."
   ],
   [
    35.925,
    "This is dynamic equilibrium."
   ],
   [
    38.073,
    "As many molecules cross one way as the other."
   ],
   [
    41.029,
    "They never stop moving."
   ],
   [
    42.422,
    "It is the net movement that stops."
   ],
   [
    44.727,
    "Now add a second dye, in purple."
   ],
   [
    47.109,
    "Each solute follows its own gradient."
   ],
   [
    49.505,
    "Orange drifts right, purple drifts left, and neither cares about the other."
   ],
   [
    54.505,
    "The blue background is the water, the solvent."
   ]
  ]
