    0.104,
    "Chapter seven, lesson three."
   ],
   [
    2.227,
    "Selective permeability, diffusion, and osmosis."
   ],
   [
    6.133,
    "Drop a speck of dye into a glass of water, and without any stirring, the color slowly spreads until the whole glass looks the same."
   ],
   [
    14.258,
    "A cell lives by the same rules, with one big difference."
   ],
   [
    17.969,
