  "cues": [
   [
    0.091,
    "Concept seven point two."
   ],
   [
    1.94,
    "A cell must exchange materials with its surroundings, and the plasma membrane controls that traffic."
   ],
   [
    8.099,
    "The membrane is selectively permeable."
   ],
   [
    10.755,
    "It lets some substances cross more easily than others."
   ],
   [
    14.219,
    "Start with hydrophobic, or nonpolar, molecules, like hydrocarbons."
   ],
   [
    19.466,
    "Oxygen and carbon dioxide are small nonpolar molecules too."
   ],
   [
    23.828,
    "They dissolve in the oily core of the bilayer, so they cross rapidly."
   ],
   [
    28.438,
    "Polar molecules, such as sugars, do not cross the membrane easily."
   ],
   [
    32.917,
    "A sugar is hydrophilic, and the core is made of hydrophobic tails, so a sugar has nowhere comfortable to go."
   ],
   [
    39.766,
    "Charged ions have an even harder time."
   ],
   [
    42.148,
    "That point goes a little beyond the slides, but it follows the same rule: an ion is wrapped in water, and that wrapping cannot slip into the oil."
   ],
   [
    51.172,
    "Think of a border checkpoint."
   ],
   [
    52.852,
    "Some travelers walk straight through."
   ],
   [
    55.0,
    "Everyone else needs a gate."
   ]
  ]
 },
