    0.117,
    "The difference in a substance's concentration from one area to another is its concentration gradient."
   ],
   [
    6.328,
    "Substances diffuse down their gradient, from where they are crowded to where they are sparse, and no work is needed to move them that way."
   ],
   [
    14.401,
    "Like a ball rolling downhill."
   ],
   [
    16.328,
    "That is why diffusion across a membrane is called passive transport."
   ],
   [
    20.378,
    "The cell spends no energy."
   ],
   [
    22.188,
    "A nonpolar molecule can go straight through the bilayer."
   ],
   [
    25.664,
    "A polar one can use a transport protein."
   ],
   [
    28.359,
    "Either way, it is still going downhill."
   ]
