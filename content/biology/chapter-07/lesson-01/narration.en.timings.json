  "cues": [
   [
    0.117,
    "The fluidity of a membrane depends on temperature."
   ],
   [
    3.125,
    "As a membrane cools, it switches from fluid to solid."
   ],
   [
    6.901,
    "Membranes must be fluid to work properly."
   ],
   [
    9.675,
    "They are usually about as fluid as salad oil."
   ],
   [
    12.5,
    "The tails matter."
   ],
   [
    13.672,
    "A saturated tail has no double bonds, so it is straight, and straight tails pack tightly."
   ],
   [
    19.544,
    "That makes the membrane viscous, less fluid."
   ],
   [
    22.617,
    "An unsaturated tail has one or more double bonds, and each double bond makes a kink."
   ],
   [
    28.62,
    "Kinks keep the tails from packing tightly, so the membrane stays fluid."
   ],
   [
    33.034,
    "So membranes rich in unsaturated fatty acids are more fluid than those rich in saturated fatty acids, and they stay fluid at lower temperatures."
   ]
  ]
 },
