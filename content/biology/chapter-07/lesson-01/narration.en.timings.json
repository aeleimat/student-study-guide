  "cues": [
   [
    0.104,
    "Animal cell membranes also contain cholesterol, a steroid made of four rings."
   ],
   [
    5.56,
    "It sits wedged between the phospholipid tails."
   ],
   [
    8.594,
    "At a warm temperature, like thirty seven degrees Celsius, it restrains the movement of the phospholipids, so the membrane does not get too loose."
   ],
   [
    17.604,
    "At a cool temperature, it prevents the tails from packing tightly, so the membrane does not stiffen."
   ],
   [
    23.607,
    "Cholesterol is a fluidity buffer."
   ],
   [
    25.977,
    "It keeps the membrane from being too fluid when warm, and too solid when cool."
   ]
  ]
