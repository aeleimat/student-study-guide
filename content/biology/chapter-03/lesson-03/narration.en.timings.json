  "cues": [
   [
    0.104,
    "Water dissolves more than ions."
   ],
   [
    2.227,
    "Polar molecules, like sugar, have charged patches that water bonds to."
   ],
   [
    6.914,
    "A large molecule such as a protein dissolves too, if it has ionic and polar regions on its surface."
   ],
   [
    13.62,
    "A substance with an affinity for water is called hydrophilic."
   ],
   [
    17.643,
    "Oil is different."
   ],
   [
    18.867,
    "Its molecules have no charged or polar regions, so water has nothing to hold on to."
   ],
   [
    24.622,
    "Such a substance is hydrophobic."
   ],
   [
    26.979,
    "The water bonds to itself instead, and pushes the oil into drops."
   ]
  ]
