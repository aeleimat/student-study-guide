  "cues": [
   [
    0.117,
    "Take table salt, sodium chloride."
   ],
   [
    2.682,
    "In the crystal, small positive sodium ions and larger negative chloride ions are packed together."
   ],
   [
    9.076,
    "Water molecules crowd around its surface."
   ],
   [
    11.966,
    "Around a sodium ion, the negative oxygen ends point in."
   ],
   [
    16.094,
    "Around a chloride ion, the positive hydrogen ends point in."
   ],
   [
    20.326,
    "Each ion is pulled out of the crystal, and water closes around it."
   ],
   [
    24.74,
    "That sphere of water molecules is a hydration shell."
   ],
   [
    28.073,
    "Wrapped like this, the ions stay apart, and the salt is dissolved."
   ],
   [
    32.643,
    "There is a limit, though."
   ],
   [
    34.076,
    "Only about thirty-six grams of salt will dissolve in a hundred milliliters of water at room temperature."
   ]
  ]
