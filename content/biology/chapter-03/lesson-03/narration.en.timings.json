  "cues": [
   [
    0.104,
    "Start with ice."
   ],
   [
    1.341,
    "In liquid water, hydrogen bonds break and re-form all the time, so the molecules tumble close together."
   ],
   [
    8.516,
    "As the water freezes, the bonds stop breaking."
   ],
   [
    11.68,
    "Each molecule is held by four bonds, at fixed angles, and together they build an open lattice with gaps in it."
   ],
   [
    19.049,
    "Locked apart like this, the same molecules take up more room."
   ],
   [
    22.76,
    "More room for the same mass means a lower density."
   ],
   [
    25.938,
    "So ice is less dense than liquid water, and it floats."
   ]
  ]
 },
