  "cues": [
   [
    0.104,
    "Now, how strong is the weak acid?"
   ],
   [
    2.344,
    "Put a thousand acetic acid molecules in water, and only about thirteen give up a proton."
   ],
   [
    8.438,
    "Most stay whole."
   ],
   [
    9.557,
    "A strong acid, hydrochloric acid, splits essentially all of them."
   ],
   [
    14.245,
    "The dissociation constant, Ka, measures this."
   ],
   [
    17.852,
    "It compares the products, H plus and the conjugate base, with the acid left whole."
   ],
   [
    23.659,
    "For acetic acid, Ka is about one point seven times ten to the minus five."
   ],
   [
    28.75,
    "Chemists turn it into a pKa, minus the log of Ka, so acetic acid has a pKa of four point seven six, about four point eight."
   ],
   [
    37.943,
    "Watch the direction."
   ],
   [
    39.193,
    "A smaller Ka means less dissociation, a larger pKa, and a weaker acid."
   ],
   [
    44.74,
    "For a strong acid the acid is almost gone, so a pKa tells us little."
   ],
   [
    49.909,
    "It is only useful for weak acids."
   ]
  ]
