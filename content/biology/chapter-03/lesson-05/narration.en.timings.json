  "cues": [
   [
    0.104,
    "Why does it work?"
   ],
   [
    1.185,
    "A buffer holds two partners: a weak acid, and its conjugate base, the particle left when the acid has given up a proton."
   ],
   [
    9.31,
    "Acetic acid is the weak acid, and acetate is its conjugate base."
   ],
   [
    14.492,
    "When H plus arrives, acetate takes it up and becomes acetic acid."
   ],
   [
    19.401,
    "When hydroxide arrives, acetic acid gives up H plus, which joins the hydroxide to make water."
   ],
   [
    26.471,
    "Either way, one partner is spent and the other is made, so the H plus concentration barely moves."
   ],
   [
    33.229,
    "The same works the other way round: a weak base, like ammonia, with its conjugate acid, ammonium."
   ]
  ]
 },
