  "cues": [
   [
    0.104,
    "Last, evaporation."
   ],
   [
    1.888,
    "In liquid water, molecules move at many different speeds."
   ],
   [
    6.133,
    "The fastest ones at the surface can break all their bonds and escape as gas."
   ],
   [
    11.341,
    "They carry away more than their share of kinetic energy, so the average of those left behind drops."
   ],
   [
    17.227,
    "The water cools."
   ],
   [
    18.464,
    "Turning one gram of water into vapor takes a lot of heat, about five hundred eighty calories at body temperature."
   ],
   [
    25.924,
    "This is the heat of vaporization."
   ],
   [
    28.294,
    "Evaporating just one gram of sweat can cool a hundred grams of water by almost six degrees."
   ],
   [
    34.805,
    "That is why sweating cools you, and why evaporation steadies the temperature of ponds and leaves."
   ]
  ]
 },
