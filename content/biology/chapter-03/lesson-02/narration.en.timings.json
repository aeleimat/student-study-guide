    0.117,
    "Part two is heat."
   ],
   [
    1.471,
    "In warm water, the molecules dart around quickly."
   ],
   [
    4.922,
    "In cold water, they drift slowly."
   ],
   [
    7.344,
    "Moving things have kinetic energy, and the random motion of molecules is thermal energy."
   ],
   [
    13.047,
    "Temperature is the average kinetic energy of a molecule in the sample."
   ],
   [
    17.656,
    "It is not the total."
   ],
   [
    18.984,
    "A bathtub of warm water holds far more thermal energy than a cup of boiling water, though the cup has the higher temperature."
   ],
   [
    26.536,
    "Heat is thermal energy on the move, passing from the warmer body to the cooler one."
   ]
  ]
