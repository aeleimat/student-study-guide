   [
    0.104,
    "Cohesion also shows at the top of a pond."
   ],
   [
    3.073,
    "A molecule deep in the water is pulled equally in every direction."
   ],
   [
    7.526,
    "One at the surface has water beside it and below it, but none above."
   ],
   [
    11.94,
    "So it is pulled inward and sideways, and the surface acts like a stretched skin."
   ],
   [
    17.018,
    "That resistance to being broken is surface tension, and it lets a water strider stand on the pond."
   ]
  ]
