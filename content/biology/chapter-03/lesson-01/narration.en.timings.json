  "cues": [
   [
    0.117,
    "Start with the bond."
   ],
   [
    1.51,
    "A covalent bond forms when two atoms share a pair of electrons."
   ],
   [
    5.781,
    "But sharing is not always fair."
   ],
   [
    7.852,
    "Every atom pulls on shared electrons with some strength, and that pull is called electronegativity."
   ],
   [
    13.932,
    "Two identical atoms pull equally, so the electrons sit in the middle."
   ],
   [
    18.789,
    "Oxygen pulls much harder than hydrogen."
   ],
   [
    21.432,
    "So in each oxygen to hydrogen bond, the electrons spend more time near the oxygen."
   ]
  ]
 },
