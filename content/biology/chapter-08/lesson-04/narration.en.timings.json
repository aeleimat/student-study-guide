    "Together, those two make adenosine."
   ],
   [
    14.05,
    "And a tail of three phosphate groups."
   ],
   [
    16.458,
    "Tri-phosphate means three phosphates."
   ],
   [
    19.141,
    "Each phosphate carries a negative charge, and like charges push each other apart."
   ],
   [
    24.049,
    "So the three are crowded together in the tail, like springs pressed tight."
   ]
  ]
