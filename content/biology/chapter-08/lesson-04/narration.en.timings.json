  "cues": [
   [
    0.104,
    "Now a worked example."
   ],
   [
    1.576,
    "Turning glutamic acid and ammonia into glutamine is endergonic."
   ],
   [
    6.406,
    "Delta G is plus three point four kilocalories per mole, so on its own it will not go."
   ],
   [
    12.201,
    "But ATP hydrolysis is exergonic, minus seven point three."
   ],
   [
    17.07,
    "Step one."
   ],
   [
    18.021,
    "ATP transfers a phosphate group to glutamic acid."
   ],
   [
    21.966,
    "That is phosphorylation, and the glutamic acid is now a phosphorylated intermediate."
   ],
   [
    27.409,
    "It is less stable, and more reactive, than before."
   ],
   [
    30.964,
    "ADP leaves."
   ],
   [
    32.5,
    "Step two."
   ],
   [
    33.464,
    "Ammonia replaces the phosphate, which leaves as inorganic phosphate, and glutamine is made."
   ],
   [
    39.883,
    "Add the two energies."
   ],
   [
    41.458,
    "Plus three point four, and minus seven point three, give a net delta G of minus three point nine."
   ],
   [
    48.229,
    "Overall, the coupled reaction is exergonic, so it goes."
   ]
  ]
 },
