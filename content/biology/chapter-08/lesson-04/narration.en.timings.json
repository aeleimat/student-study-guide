   [
    0.104,
    "Add water, and the end phosphate can be broken off."
   ],
   [
    3.568,
    "That is hydrolysis."
   ],
   [
    5.052,
    "ATP plus water gives ADP, adenosine diphosphate, which has two phosphates, plus one free inorganic phosphate."
   ],
   [
    14.18,
    "Energy is released, about minus seven point three kilocalories per mole."
   ],
   [
    19.232,
    "Now be careful about where that energy comes from."
   ],
   [
    21.953,
    "It does not come from the phosphate bonds themselves."
   ],
   [
    25.013,
    "It comes from the change to a state of lower free energy."
   ],
   [
    28.503,
    "The products are more stable than ATP was, like a ball that has rolled downhill."
   ],
   [
    33.828,
    "The energy is the difference in height."
   ]
