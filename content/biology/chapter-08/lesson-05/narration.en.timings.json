   [
    0.104,
    "Chapter eight, lesson five."
   ],
   [
    1.992,
    "Enzymes and the activation energy barrier."
   ],
   [
    4.961,
    "A sugar cube sits on a table, in air full of oxygen."
   ],
   [
    8.75,
    "Burning it would release a lot of energy, yet it just sits there."
   ],
   [
    12.591,
    "It will not start on its own."
   ],
   [
    14.31,
    "But inside a living cell, sugars are broken down in a blink, at body temperature."
   ],
   [
    19.818,
    "Here is our metabolic pathway again."
   ],
   [
    22.109,
    "Today we light up enzyme one, and find out how it makes reactions fast."
   ]
  ]
