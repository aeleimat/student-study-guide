  "cues": [
   [
    0.104,
    "Now a real pathway."
   ],
   [
    1.602,
    "The initial substrate is threonine."
   ],
   [
    4.245,
    "Five enzymes in a line turn it into intermediates A, B, C and D, and then into isoleucine, the end product."
   ],
   [
    12.969,
    "Enzyme one, threonine deaminase, takes the first step."
   ],
   [
    17.188,
    "When isoleucine builds up, it binds to an allosteric site on enzyme one."
   ],
   [
    22.487,
    "The active site can no longer convert threonine to intermediate A, and the pathway is switched off."
   ],
   [
    28.529,
    "As the cell uses up isoleucine, it lets go."
   ],
   [
    31.797,
    "The active site is available again, and the pathway restarts."
   ],
   [
    35.938,
    "This is feedback inhibition."
   ],
   [
    37.891,
    "The end product shuts down the pathway, so the cell does not waste chemical resources making more than it needs."
   ]
  ]
 },
