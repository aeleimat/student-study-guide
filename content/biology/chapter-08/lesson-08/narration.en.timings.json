  "cues": [
   [
    0.104,
    "Chapter eight, lesson 8."
   ],
   [
    1.94,
    "Allosteric Regulation and Feedback Inhibition."
   ],
   [
    5.065,
    "A thermostat does not heat a house forever."
   ],
   [
    7.773,
    "When the room is warm enough, it switches the heater off."
   ],
   [
    11.302,
    "When the room cools, it switches it back on."
   ],
   [
    14.154,
    "A cell has the same problem."
   ],
   [
    15.859,
    "Its chemistry runs all the time, and it must not make too much of anything."
   ],
   [
    20.417,
    "Here is our metabolic pathway again: a starting molecule, an enzyme at every step, and a product at the end."
   ],
   [
    27.93,
    "Today we light the stop sign that comes back from the product to the first enzyme."
   ]
  ]
