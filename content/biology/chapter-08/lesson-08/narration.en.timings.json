  "cues": [
   [
    0.104,
    "Most allosterically regulated enzymes are made from several polypeptide subunits."
   ],
   [
    5.664,
    "Here is one with four."
   ],
   [
    7.044,
    "Each subunit has an active site, where the substrate binds, and a regulatory site, where an activator or an inhibitor binds."
   ],
   [
    15.456,
    "The whole enzyme swings back and forth between two forms, an active form and an inactive form."
   ],
   [
    21.576,
    "An activator binds to a regulatory site and stabilizes the active form, so the enzyme keeps working."
   ],
   [
    28.516,
    "An inhibitor binds and stabilizes the inactive form, where the active sites no longer work, so the enzyme slows or stops."
   ],
   [
    37.318,
    "Notice that the regulator does not sit in the active site."
   ],
   [
    40.977,
    "It binds somewhere else, and the change in shape does the work."
   ]
  ]
