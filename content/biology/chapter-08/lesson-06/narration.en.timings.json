  "cues": [
   [
    0.104,
    "The reactant that an enzyme acts on is called its substrate."
   ],
   [
    3.841,
    "The substrate binds to a region of the enzyme called the active site."
   ],
   [
    8.333,
    "It is a small pocket, a groove or a notch on the surface, formed by just a few of the enzyme's amino acids."
   ],
   [
    15.703,
    "While the substrate sits in the active site, the pair is called the enzyme-substrate complex."
   ],
   [
    21.328,
    "Enzymes are specific."
   ],
   [
    22.891,
    "The shape and chemistry of the pocket match one substrate, or a few close relatives."
   ],
   [
    28.255,
    "A molecule with the wrong shape cannot bind, so the enzyme ignores it."
   ],
   [
    32.93,
    "Sucrase, from last lesson, splits sucrose, but leaves other sugars alone."
   ],
   [
    38.398,
    "That is why a cell needs a different enzyme for every step of a pathway."
   ]
  ]
 },
