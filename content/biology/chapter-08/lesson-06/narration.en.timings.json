  "cues": [
   [
    0.104,
    "At first, the pocket is not a perfect mould."
   ],
   [
    3.112,
    "When the substrate enters, the active site changes shape a little and closes in around it."
   ],
   [
    9.05,
    "This is called induced fit."
   ],
   [
    10.898,
    "It brings the chemical groups of the active site into positions where they can catalyse the reaction."
   ],
   [
    16.797,
    "Think of a hand sliding into a glove."
   ],
   [
    19.336,
    "The glove is loose, and then it hugs."
   ],
   [
    21.901,
    "Notice what this means."
   ],
   [
    23.359,
    "The enzyme flexes, but it is not used up."
   ],
   [
    26.367,
    "When the products leave, it springs back to its first shape, ready for the next substrate."
   ]
  ]
