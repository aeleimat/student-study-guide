   [
    0.104,
    "Chapter eight, lesson one."
   ],
   [
    1.966,
    "Metabolism, pathways and forms of energy."
   ],
   [
    5.352,
    "On a summer night, a firefly blinks in the dark."
   ],
   [
    8.802,
    "Where does that light come from?"
   ],
   [
    10.378,
    "The animal has turned energy into light."
   ],
   [
    13.073,
    "That is called bioluminescence."
   ],
   [
    15.143,
    "Let's go inside, into one cell of its glowing tail."
   ],
   [
    19.01,
    "A living cell is a miniature chemical factory, where thousands of reactions happen at once."
   ],
   [
    25.26,
    "It pulls energy out of food, and it uses that energy to do work."
   ]
  ]
