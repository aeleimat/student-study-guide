   [
    0.104,
    "All of those reactions together have a name."
   ],
   [
    2.747,
    "Metabolism is the totality of an organism's chemical reactions."
   ],
   [
    7.318,
    "And metabolism is an emergent property of life."
   ],
   [
    10.534,
    "No single molecule is alive, or has metabolism."
   ],
   [
    14.375,
    "It arises from the interactions between molecules within the cell, the way a whole orchestra makes music that no single instrument makes alone."
   ],
   [
    23.646,
    "Take the molecules out of the cell, and the metabolism is gone."
   ]
