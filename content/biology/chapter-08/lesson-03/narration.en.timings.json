   [
    0.104,
    "Chapter eight, lesson 3."
   ],
   [
    2.161,
    "Free energy, stability and equilibrium."
   ],
   [
    5.365,
    "A ball on a high ledge is unstable."
   ],
   [
    8.047,
    "Give it a nudge and it rolls down, and it never rolls back up on its own."
   ],
   [
    12.786,
    "Chemical reactions inside a cell behave the same way."
   ],
   [
    16.523,
    "Here is our pathway strip again."
   ],
   [
    18.411,
    "Today we light the drop in energy along it."
   ],
   [
    21.354,
    "Each arrow is a step downhill, and free energy tells us whether a step will run by itself."
   ]
  ]
