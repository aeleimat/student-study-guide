  "cues": [
   [
    0.182,
    "Free energy is the energy of a system that can do work, when temperature and pressure are uniform, as they are in a living cell."
   ],
   [
    8.112,
    "Biologists write its change as delta G."
   ],
   [
    11.25,
    "Delta G equals delta H, minus T times delta S."
   ],
   [
    15.911,
    "Delta H is the change in total energy, called enthalpy."
   ],
   [
    20.195,
    "Delta S is the change in entropy, the disorder."
   ],
   [
    23.919,
    "And T is the temperature, in Kelvin."
   ],
   [
    26.406,
    "Body temperature, thirty-seven degrees Celsius, is about three hundred ten Kelvin."
   ],
   [
    31.641,
    "Here is the rule."
   ],
   [
    32.747,
    "Only a process with a negative delta G is spontaneous."
   ],
   [
    36.719,
    "And spontaneous processes can be harnessed to do work."
   ],
   [
    40.247,
    "A worked example, with made-up numbers."
   ],
   [
    42.839,
    "Suppose delta H is minus five kilocalories per mole, and T times delta S is plus three."
   ],
   [
    49.505,
    "Then delta G is minus five, minus three, which is minus eight."
   ],
   [
    54.323,
    "Negative, so the reaction runs by itself."
   ],
   [
    57.435,
    "Notice that a bigger rise in disorder makes delta G more negative."
   ]
  ]
 },
