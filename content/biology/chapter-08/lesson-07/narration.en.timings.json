  "cues": [
   [
    0.104,
    "Other chemicals are inhibitors, and they come in two kinds."
   ],
   [
    3.867,
    "A competitive inhibitor looks like the substrate."
   ],
   [
    6.836,
    "It binds to the active site, and competes with the substrate for entry, like a look-alike key jammed in a lock."
   ],
   [
    13.932,
    "While it sits there, the substrate is shut out."
   ],
   [
    16.771,
    "But it is a numbers game."
   ],
   [
    18.203,
    "Add more substrate, and the substrate wins the active sites more often."
   ],
   [
    22.682,
    "So this kind of inhibition can be overcome by increasing the concentration of substrate."
   ]
  ]
 },
