  "cues": [
   [
    0.091,
    "A noncompetitive inhibitor binds to another part of the enzyme, not the active site."
   ],
   [
    5.742,
    "That makes the enzyme change shape, and the active site becomes less effective."
   ],
   [
    10.521,
    "The substrate fits badly, however much of it there is, so extra substrate does not fully fix it."
   ],
   [
    16.784,
    "Toxins and poisons are often irreversible inhibitors."
   ],
   [
    20.677,
    "Sarin, a nerve gas, binds covalently to a serine in the active site of acetylcholinesterase, an enzyme of the nervous system, and it stays bound."
   ],
   [
    31.042,
    "Sarin is not a noncompetitive inhibitor: it binds the active site itself, permanently."
   ],
   [
    37.07,
    "It is an irreversible poison."
   ],
   [
    39.023,
    "With that enzyme jammed, nerve signals cannot be switched off."
   ]
  ]
