  "cues": [
   [
    0.104,
    "The ER is a network of flattened sacs and tubes."
   ],
   [
    3.594,
    "Each sac is called a cisterna, and the plural is cisternae."
   ],
   [
    7.708,
    "The space inside is the ER lumen."
   ],
   [
    10.482,
    "It has two main regions."
   ],
   [
    12.357,
    "Smooth ER has no ribosomes at all."
   ],
   [
    15.104,
    "Rough ER has ribosomes attached to the outside of its membrane."
   ],
   [
    19.362,
    "Those are called bound ribosomes."
   ],
   [
    21.432,
    "And where the ER passes work along, a piece of its membrane buds off as a transport vesicle."
   ],
   [
    27.695,
    "This part is called transitional ER."
   ]
  ]
