    0.104,
    "Let's follow one product all the way."
   ],
   [
    2.331,
    "A pancreas cell makes digestive enzymes, and they are glycoproteins."
   ],
   [
    7.122,
    "A bound ribosome on the rough ER builds the protein chain."
   ],
   [
    11.146,
    "The chain enters the lumen, and a carbohydrate is attached."
   ],
   [
    15.3,
    "It is now a glycoprotein."
   ],
   [
    17.227,
    "A transport vesicle buds off from the transitional ER."
   ],
   [
    21.25,
    "The vesicle reaches the cis face of the Golgi, and joins it."
   ],
   [
    25.404,
    "The product moves through the cisternae, and the Golgi modifies it."
   ],
   [
    29.583,
    "At the trans face, it is packaged into a new vesicle."
   ],
   [
    33.646,
    "That vesicle carries the finished glycoprotein away, toward the cell surface, or to other parts of the cell."
   ],
   [
    40.625,
    "We will follow it further next lesson."
   ]
  ]
