  "cues": [
   [
    0.117,
    "Start with the wall."
   ],
   [
    1.432,
    "Plants have cell walls."
   ],
   [
    2.852,
    "So do prokaryotes, fungi, and some protists."
   ],
   [
    6.315,
    "Animal cells do not."
   ],
   [
    7.865,
    "A wall protects the cell, and maintains its shape."
   ],
   [
    11.172,
    "It also helps prevent excessive water uptake."
   ],
   [
    14.154,
    "A plant cell soaks up water and swells, until the wall pushes back."
   ],
   [
    18.841,
    "The wall does not keep water out."
   ],
   [
    20.742,
    "It stops the cell from bursting."
   ],
   [
    22.773,
    "What is it made of?"
   ],
   [
    23.932,
    "Cellulose fibers, embedded in other polysaccharides and protein."
   ],
   [
    28.62,
    "Think of steel rods set in concrete."
   ],
   [
    31.133,
    "The fibers give strength, and the surrounding material fills the gaps."
   ]
  ]
