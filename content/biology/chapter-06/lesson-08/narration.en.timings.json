   [
    0.104,
    "A wall is a barrier."
   ],
   [
    1.55,
    "So how do plant cells talk to each other?"
   ],
   [
    3.893,
    "Through channels called plasmodesmata."
   ],
   [
    6.055,
    "Each plasmodesma is a pore through the walls, lined by the plasma membrane, so the cytoplasm of one cell runs into its neighbor's."
   ],
   [
    14.831,
    "Water, small solutes, and even proteins and RNA can pass from one plant cell to the next."
   ],
   [
    21.419,
    "Plasmodesmata belong to plants."
   ],
   [
    23.776,
    "Animal cells have other kinds of connections, and we meet them soon."
   ]
  ]
