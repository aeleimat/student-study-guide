  "cues": [
   [
    0.104,
    "How does the cell hold on to that web?"
   ],
   [
    2.227,
    "With integrins."
   ],
   [
    3.451,
    "They are receptor proteins that span the plasma membrane."
   ],
   [
    6.914,
    "On the outside, an integrin binds the matrix."
   ],
   [
    10.651,
    "On the inside, it links to the microfilaments of the cytoskeleton."
   ],
   [
    15.104,
    "So the matrix is tied to the cell's own scaffolding."
   ],
   [
    18.594,
    "A pull on the matrix can be felt inside the cell."
   ],
   [
    21.784,
    "The matrix does four jobs."
   ],
   [
    23.867,
    "It gives support, and it helps cells adhere."
   ],
   [
    26.732,
    "It takes part in movement, and in regulation of what the cell does."
   ]
  ]
