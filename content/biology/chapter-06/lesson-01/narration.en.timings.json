   [
    0.104,
    "A microscope shows what a cell looks like."
   ],
   [
    2.552,
    "To learn what each part does, scientists use cell fractionation."
   ],
   [
    6.914,
    "First, break the cells open."
   ],
   [
    8.971,
    "Then spin the mixture in an ultracentrifuge, a very fast centrifuge."
   ],
   [
    13.971,
    "The heaviest parts sink first, and the lighter ones stay in the liquid, so spinning faster in steps separates the organelles from one another."
   ],
   [
    22.409,
    "Each separated batch can then be tested, using biochemistry, to see what chemistry it carries out."
   ],
   [
    29.023,
    "Put those results together with the picture from the microscope, and you can link each organelle's structure to its function."
   ]
  ]
