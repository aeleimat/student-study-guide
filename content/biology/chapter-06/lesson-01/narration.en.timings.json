  "cues": [
   [
    0.117,
    "Prokaryotic cells belong to bacteria and archaea."
   ],
   [
    3.724,
    "The slide calls the second group archaebacteria, but today we say archaea."
   ],
   [
    8.633,
    "Eukaryotic cells make up protists, fungi, animals, and plants."
   ],
   [
    13.685,
    "Eukaryotic cells are much larger."
   ],
   [
    16.029,
    "Many prokaryotic cells could fit inside one."
   ],
   [
    19.245,
    "A eukaryote keeps its DNA in a nucleus, a compartment wrapped in a membrane."
   ],
   [
    24.779,
    "A prokaryote has no nucleus."
   ],
   [
    26.966,
    "Its DNA sits in a region called the nucleoid, with no membrane around it."
   ],
   [
    31.979,
    "A eukaryote also has many other membrane bound organelles, small compartments that each do one job."
   ],
   [
    38.672,
    "A prokaryote has none."
   ],
   [
    40.378,
    "In a eukaryote, the cytoplasm is everything between the plasma membrane and the nucleus."
   ]
  ]
 },
