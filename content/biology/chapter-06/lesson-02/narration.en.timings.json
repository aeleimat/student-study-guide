  "cues": [
   [
    0.169,
    "First, let's compare the animal cell with a plant cell."
   ],
   [
    3.464,
    "Most of the organelles are the same."
   ],
   [
    5.534,
    "Both have a nucleus, ribosomes, rough and smooth endoplasmic reticulum, a Golgi apparatus, mitochondria, peroxisomes, and a cytoskeleton."
   ],
   [
    15.859,
    "Only the plant cell has a cell wall, a large central vacuole, chloroplasts, and plasmodesmata, the channels through the wall."
   ],
   [
    23.945,
    "Only the animal cell, on this map, has a centrosome and lysosomes."
   ],
   [
    29.128,
    "Some animal cells also have a flagellum, like a sperm cell."
   ],
   [
    32.982,
    "Both keep their DNA in a nucleus."
   ],
   [
    35.69,
    "So let's go in."
   ]
  ]
