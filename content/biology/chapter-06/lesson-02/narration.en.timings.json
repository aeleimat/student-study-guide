  "cues": [
   [
    0.104,
    "Ribosomes are the workbenches that build proteins."
   ],
   [
    3.372,
    "A ribosome is a particle made of rRNA and protein."
   ],
   [
    7.513,
    "It has two pieces, a large subunit, and a small subunit."
   ],
   [
    11.745,
    "Together they grip a messenger RNA and build a polypeptide, as in chapter five."
   ],
   [
    17.292,
    "Notice that a ribosome reads the messenger copy, not the DNA itself."
   ],
   [
    22.07,
    "Some ribosomes float free in the cytosol."
   ],
   [
    25.26,
    "Others are bound to the outside of the endoplasmic reticulum, or of the nuclear envelope."
   ],
   [
    30.677,
    "In a micrograph, free and bound ribosomes look the same."
   ],
   [
    34.596,
    "What differs is where they sit."
   ]
  ]
 },
