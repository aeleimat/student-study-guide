  "cues": [
   [
    0.104,
    "Where do microtubules come from?"
   ],
   [
    2.175,
    "Near the nucleus, many animal cells have a centrosome."
   ],
   [
    5.794,
    "It is a region where microtubules are organized, and from which they grow out into the cell."
   ],
   [
    11.328,
    "Inside an animal centrosome is a pair of centrioles."
   ],
   [
    15.013,
    "Look at one centriole end on."
   ],
   [
    16.888,
    "Its microtubules sit in a ring of nine triplets, three fused tubes in each."
   ],
   [
    22.747,
    "Nine triplets of three tubes each make twenty-seven microtubules in one centriole."
   ],
   [
    28.763,
    "Before a cell divides, these are the starting points for the fibers that separate the chromosomes."
   ]
  ]
