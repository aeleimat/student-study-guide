  "cues": [
   [
    0.117,
    "The cytoskeleton is a network of fibers running through the cytoplasm."
   ],
   [
    4.453,
    "It organizes the cell's structures and activities, and it anchors many organelles in place."
   ],
   [
    10.56,
    "There are three kinds of fiber."
   ],
   [
    12.448,
    "Microtubules are the thickest, about twenty-five nanometers across."
   ],
   [
    17.161,
    "Intermediate filaments are in the middle, eight to twelve nanometers."
   ],
   [
    21.523,
    "Microfilaments are the thinnest, about seven nanometers."
   ],
   [
    25.508,
    "Together they give the cell support and shape, they let it move, and they help regulate its chemistry."
   ],
   [
    31.706,
    "This lesson follows the thickest fiber."
   ],
   [
    34.232,
    "The other two come in the next lesson."
   ]
  ]
 },
