  "cues": [
   [
    0.104,
    "A microtubule is a hollow rod."
   ],
   [
    2.604,
    "It is about twenty-five nanometers wide, and its hollow center is fifteen."
   ],
   [
    7.604,
    "It can be anywhere from two hundred nanometers to twenty-five micrometers long."
   ],
   [
    12.513,
    "Its wall is built from thirteen columns of tubulin."
   ],
   [
    15.729,
    "The repeating unit is a tubulin dimer, one alpha tubulin joined to one beta tubulin."
   ],
   [
    21.589,
    "Microtubules shape the cell, guide organelles, and, in cell division, move chromosomes."
   ],
   [
    27.93,
    "They also work as tracks."
   ],
   [
    29.674,
    "A vesicle carries cargo, and a receptor on its surface grips a motor protein."
   ],
   [
    35.156,
    "Powered by A T P, the motor protein walks along the microtubule and pulls the vesicle with it."
   ],
   [
    41.784,
    "Think of a train on a monorail."
   ]
  ]
 },
