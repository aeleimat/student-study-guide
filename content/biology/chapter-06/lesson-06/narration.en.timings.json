  "cues": [
   [
    0.104,
    "Now back to the sperm and the airway."
   ],
   [
    2.591,
    "Both are microtubules at work."
   ],
   [
    4.609,
    "Cilia and flagella are extensions from the cell, built around a core of microtubules, and covered by the plasma membrane."
   ],
   [
    12.474,
    "A flagellum is long."
   ],
   [
    14.232,
    "It beats in an undulating wave, like a swimming snake, and the wave pushes the cell forward."
   ],
   [
    20.638,
    "A cilium is short, and there are usually many."
   ],
   [
    23.646,
    "It beats in two strokes."
   ],
   [
    25.586,
    "In the power stroke, it sweeps stiffly, and pushes fluid, or the cell, along."
   ],
   [
    31.406,
    "In the recovery stroke, it bends back, and returns to start."
   ],
   [
    35.599,
    "Cilia in your airway use this to sweep mucus out of the lungs."
   ]
  ]
