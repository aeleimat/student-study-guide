  "cues": [
   [
    0.104,
    "Microfilaments can also drive movement, but never alone."
   ],
   [
    4.023,
    "Their partner is myosin, a motor protein."
   ],
   [
    6.888,
    "In a muscle cell, thousands of thin actin filaments run parallel to one another."
   ],
   [
    12.487,
    "Thick myosin filaments sit between them, interdigitated, like the fingers of two hands laced together."
   ],
   [
    19.466,
    "Myosin heads grip the actin and pull."
   ],
   [
    22.214,
    "The filaments slide past each other, the overlap grows, and the whole cell shortens."
   ],
   [
    28.021,
    "Notice that neither kind of filament gets shorter."
   ],
   [
    30.794,
    "They slide."
   ],
   [
    31.823,
    "The heads need energy from the cell to do this work."
   ],
   [
    34.961,
    "Repeat that in thousands of cells, and your arm lifts."
   ]
  ]
 },
