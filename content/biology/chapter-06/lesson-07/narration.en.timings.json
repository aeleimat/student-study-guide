  "cues": [
   [
    0.104,
    "Chapter six, lesson seven."
   ],
   [
    2.344,
    "Microfilaments and intermediate filaments."
   ],
   [
    5.273,
    "Lift your arm, and muscle cells all along it shorten at once."
   ],
   [
    9.388,
    "A pond amoeba crawls across a slide with no legs at all."
   ],
   [
    13.06,
    "Both are the work of the cytoskeleton, the scaffolding and rails of the cell, lit up here on our map."
   ],
   [
    19.232,
    "Today we meet two of its three kinds of fibre."
   ],
   [
    22.448,
    "What are they made of, and how do they make a cell move?"
   ]
  ]
