    "A lysosome is a membranous sac of hydrolytic enzymes that digest macromolecules."
   ],
   [
    5.951,
    "The sac keeps the enzymes shut inside, away from the rest of the cell."
   ],
   [
    10.443,
    "Hydrolytic means they break bonds using water, the reverse of building a polymer."
   ],
   [
    15.664,
    "Lysosomal enzymes can break down proteins, fats, polysaccharides, and nucleic acids."
   ],
   [
    22.63,
    "Keeping them in a sac matters."
   ],
   [
    24.57,
    "Loose in the cytoplasm, they would digest the cell itself."
   ]
  ]
