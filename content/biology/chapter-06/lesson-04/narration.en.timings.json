  "cues": [
   [
    0.104,
    "Now let's tie this lesson to the last one."
   ],
   [
    2.422,
    "Many membranes in the cell work as one connected system, the endomembrane system."
   ],
   [
    7.747,
    "Start at the nucleus."
   ],
   [
    9.232,
    "Its envelope is joined to the endoplasmic reticulum, and the rough ER, studded with ribosomes, builds proteins."
   ],
   [
    17.214,
    "Smooth ER has no ribosomes."
   ],
   [
    19.701,
    "Transport vesicles bud off the ER, and carry their cargo along."
   ],
   [
    24.44,
    "They fuse with the cis face of the Golgi, the side that receives."
   ],
   [
    28.75,
    "The Golgi modifies, sorts, and packs the products."
   ],
   [
    32.565,
    "They leave from the trans face, the side that ships."
   ],
   [
    36.146,
    "Some vesicles become lysosomes, which stay in the cell."
   ],
   [
    40.065,
    "Others travel to the plasma membrane, and fuse with it, releasing their contents outside the cell."
