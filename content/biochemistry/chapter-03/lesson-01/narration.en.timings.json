  "cues": [
   [
    0.1,
    "The first level, primary structure, is the chain itself: the order of its amino acids."
   ],
   [
    6.027,
    "Secondary structure is the chain coiled or pleated into helices and sheets."
   ],
   [
    10.714,
    "Tertiary structure is those pieces folded into one compact three-dimensional shape."
   ],
   [
    15.623,
    "And quaternary structure is several folded chains packed together."
   ],
   [
    19.62,
    "The next two lessons take each level in turn."
   ],
   [
    22.316,
    "So what holds it all together?"
   ],
   [
    24.139,
    "Folded proteins are held together by various bonds and forces."
   ],
   [
    28.097,
    "Two are covalent, and strong."
   ],
   [
    30.402,
    "Three are non-covalent, and weak."
   ]
  ]
