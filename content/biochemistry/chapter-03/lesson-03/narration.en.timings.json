  "cues": [
   [
    0.1,
    "What holds the fold together?"
   ],
   [
    1.821,
    "This time the bonds join side chains, the R groups, not the backbone."
   ],
   [
    6.17,
    "First, hydrophobic interactions."
   ],
   [
    8.722,
    "Non-polar side chains gather in the middle, away from water."
   ],
   [
    12.446,
    "Second, hydrogen bonds between side chains that carry polar groups."
   ],
   [
    16.925,
    "Third, ionic bonds, also called salt bridges, between a positive and a negative side chain."
   ],
   [
    23.527,
    "The slide spells it iconic, but it is ionic."
   ],
   [
    26.626,
    "And fourth, the disulfide bridge between two cysteines, the only covalent one."
   ],
   [
    31.925,
    "Most of these are weak."
   ],
   [
    33.37,
    "Together, they lock the shape in place."
   ],
   [
    35.961,
    "Notice where they sit."
   ],
   [
    37.524,
    "Hydrophobic side chains hide in the core, while charged and polar side chains face the water outside."
   ]
  ]
