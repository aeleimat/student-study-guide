  "cues": [
   [
    0.1,
    "Tertiary structures come in two broad shapes."
   ],
   [
    2.915,
    "To tell them apart, divide the length of the molecule by its width."
   ],
   [
    6.821,
    "That is the axial ratio."
   ],
   [
    8.683,
    "A globular protein is compact, close to a ball."
   ],
   [
    12.042,
    "Its chain is tightly folded and coiled, and its axial ratio is under ten, about three to four."
   ],
   [
    18.175,
    "Insulin, the plasma albumins and globulins, and enzymes are globular."
   ],
   [
    22.98,
    "A fibrous protein is long, like a rope."
   ],
   [
    25.844,
    "Its chains are coiled in a spiral and held together by hydrogen bonds, and its axial ratio is over ten."
   ],
   [
    32.355,
    "Keratin, myosin, collagen and fibrin are fibrous."
   ],
   [
    36.339,
    "The shape fits the job."
   ],
   [
    37.954,
    "Globular proteins tend to be the workers, like enzymes."
   ],
   [
    41.612,
    "Fibrous proteins give strength, in hair, nails and tendon."
   ]
  ]
 },
