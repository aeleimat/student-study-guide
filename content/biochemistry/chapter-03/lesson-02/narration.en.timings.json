    0.1,
    "Primary structure is the number, type and sequence of the amino acids in the polypeptide chain."
   ],
   [
    6.04,
    "Like beads on a string, where the order of the colors matters."
   ],
   [
    9.672,
    "The main bond is the peptide bond, carbonyl then N H, that links each bead to the next."
   ],
   [
    15.245,
    "One end of the chain carries the free amino group of the first amino acid."
   ],
   [
    19.672,
    "That is the N-terminal end."
   ],
   [
    21.339,
    "The other end carries the free carboxyl group of the last amino acid."
   ],
   [
    25.701,
    "That is the C-terminal end."
   ],
   [
    27.498,
    "And we always count the amino acids from the N-terminal end."
   ],
   [
    31.157,
    "This one is number one, and this one is number twenty."
