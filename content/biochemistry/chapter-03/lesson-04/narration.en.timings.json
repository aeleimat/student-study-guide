  "cues": [
   [
    0.1,
    "Denaturation has five effects."
   ],
   [
    2.446,
    "One, enzymes lose their catalytic activity, because the active site needs the folded shape."
   ],
   [
    8.461,
    "Two, hormones lose their biological function, for the same reason."
   ],
   [
    12.303,
    "Three, solubility falls."
   ],
   [
    14.751,
    "The unfolded chains stick together and clump."
   ],
   [
    17.472,
    "Four, viscosity rises, so the liquid thickens."
   ],
   [
    20.948,
    "Five, digestibility rises."
   ],
   [
    23.67,
    "That is why we cook meat and eggs: once the chain is unfolded, digestive enzymes can reach its peptide bonds."
   ],
   [
    30.818,
    "It is also the coagulated albumin of chapter two."
   ],
   [
    34.139,
    "Solubility and viscosity change in the typical case, not for every protein."
   ]
  ]
 },
