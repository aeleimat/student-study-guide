  "cues": [
   [
    0.1,
    "Let's run the strip backwards, from the top."
   ],
   [
    2.615,
    "The subunits of the quaternary structure come apart."
   ],
   [
    5.74,
    "Each subunit loses its folded globule, the tertiary structure."
   ],
   [
    9.777,
    "The helices and sheets of the secondary structure lose their hydrogen bonds, and open out."
   ],
   [
    15.232,
    "What is left is the primary structure: the same beads, in the same order, joined by the same peptide bonds."
   ],
   [
    22.055,
    "That is the key point."
   ],
   [
    23.435,
    "Denaturation breaks the weak bonds that held the fold."
   ],
   [
    26.639,
    "The strong peptide bonds stay."
   ],
   [
    28.761,
    "So this is not hydrolysis, and no amino acids are set free."
   ],
   [
    32.98,
    "Back in chapter two, these were the primary derivatives, such as coagulated albumin."
   ]
  ]
