   [
    0.1,
    "Think of a road that forks in two."
   ],
   [
    2.172,
    "One branch ends at glucose."
   ],
   [
    4.243,
    "The slide calls it carbohydrate, and glucose is the carbohydrate your blood carries."
   ],
   [
    9.62,
    "An amino acid whose skeleton goes down this branch is called glucogenic, because it can be made into glucose."
   ],
   [
    16.417,
    "The other branch ends at ketone bodies, a fuel the liver makes from small carbon pieces."
   ],
   [
    21.678,
    "An amino acid on this branch is called ketogenic."
   ],
   [
    24.998,
    "And some amino acids send part of the skeleton down each branch."
   ],
   [
    28.917,
    "Those are the mixed ones: both glucogenic and ketogenic."
   ],
   [
    32.407,
    "So there are three classes."
   ],
   [
    34.191,
    "Ketogenic, mixed, and glucogenic."
   ]
  ]
