  "cues": [
   [
    0.1,
    "Now the rings."
   ],
   [
    1.339,
    "Aromatic means a benzene ring: six carbons in a hexagon, with alternating double bonds."
   ],
   [
    7.316,
    "Phenylalanine is a benzene ring on a C H two arm."
   ],
   [
    10.896,
    "Tyrosine is the same, plus an O H group on the far side of the ring."
   ],
   [
    15.363,
    "A benzene ring carrying an O H is called a phenol group."
   ],
   [
    18.943,
    "Heterocyclic."
   ],
   [
    20.167,
    "Tryptophan has an indole ring: a benzene ring joined to a five-sided ring that holds one nitrogen with its hydrogen."
   ],
   [
    27.094,
    "Two rings sharing one edge."
   ],
   [
    28.852,
    "Histidine has an imidazole ring: five-sided, with two nitrogens."
   ],
   [
    33.93,
    "Some books put tryptophan under aromatic, because it contains a benzene ring, and histidine is also basic."
   ],
   [
    40.441,
    "We follow the lecture: both are heterocyclic."
   ],
   [
    43.54,
    "Last, proline."
   ],
   [
    45.115,
    "Its ring is five-sided with one nitrogen: a pyrrolidine ring."
   ],
   [
    49.685,
    "That nitrogen is the amino group itself, bent round to join the side chain."
   ],
   [
    54.256,
    "That is why proline is called an imino acid."
   ]
  ]
 },
