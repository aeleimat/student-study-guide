  "cues": [
   [
    0.1,
    "An amino acid is a structural unit of protein, a building block."
   ],
   [
    4.581,
    "Think of a tower made of bricks."
   ],
   [
    6.586,
    "The tower is the protein, and each brick is an amino acid."
   ],
   [
    10.545,
    "The protein is a long chain of them."
   ],
   [
    12.771,
    "How do we get the bricks back?"
   ],
   [
    14.425,
    "By hydrolysis, which means breaking bonds with water."
   ],
   [
    18.084,
    "Boiling the protein with acid does it."
   ],
   [
    20.519,
    "So does boiling it with alkali."
   ],
   [
    22.498,
    "And so do enzymes, which is exactly what happens in your gut after a meal."
   ],
   [
    26.977,
    "Either way, the protein falls apart into free amino acids."
   ],
   [
    31.027,
    "Egg, milk and beans all end up as the same small set of pieces."
   ]
  ]
 },
