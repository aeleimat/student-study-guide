    0.1,
    "The simplest case is glycine."
   ],
   [
    2.159,
    "Its side chain R is just one hydrogen atom, so there is almost nothing there."
   ],
   [
    6.639,
    "Alanine comes next."
   ],
   [
    8.318,
    "Its R is a methyl group: one carbon with three hydrogens."
   ],
   [
    12.055,
    "Serine has a methyl group with a hydroxyl on the end."
   ],
   [
    15.363,
    "Cover the R, and the three are twins: the same carbon, the same amino group, the same carboxyl group."
   ],
   [
    21.912,
    "Uncover it, and each is a different amino acid."
   ],
   [
    25.076,
    "Swap the R, and you swap the amino acid."
   ],
   [
    28.019,
    "Bigger groups, rings, sulfur, charges: all of these are possible."
   ],
   [
    33.084,
    "The next lesson sorts them."
   ]
  ]
