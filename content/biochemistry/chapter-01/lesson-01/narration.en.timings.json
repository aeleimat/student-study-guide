   [
    0.1,
    "Chapter one, lesson one."
   ],
   [
    2.029,
    "What amino acids are, and the one shape they all share."
   ],
   [
    5.467,
    "Picture a dinner plate: an egg, a glass of milk, a spoonful of beans."
   ],
