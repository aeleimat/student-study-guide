   [
    0.1,
    "How do two amino acids join?"
   ],
   [
    2.081,
    "Here are two amino acid cards."
   ],
   [
    4.295,
    "On the first, look at the carboxyl group."
   ],
   [
    7.094,
    "On the second, look at the amino group."
   ],
   [
    9.503,
    "The carboxyl group of the first unites with the amino group of the next."
   ],
   [
    13.8,
    "It gives up an O H, the amino group gives up a hydrogen, and together they leave as water."
   ],
   [
    19.581,
    "So one water molecule is released."
   ],
   [
    21.938,
    "What remains is a link between a carbon and a nitrogen: C O, N H."
   ],
   [
    26.886,
    "This is the peptide link, also called the peptide bond."
   ],
   [
    30.232,
    "A third amino acid joins the same way, at the free end of the chain, and every join releases one more water."
   ]
  ]
